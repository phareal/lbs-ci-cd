{
  "name": "ci-cd-user-api",
  "version": "1.0.0",
  "description": "API de gestion d'utilisateurs avec Node.js, Express, SQLite et ESLint",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint --config eslint.config.cjs \"src/**/*.js\"",
    "test": "jest --runInBand --coverage",
    "test:coverage": "jest --runInBand --coverage"
  },
  "devDependencies": {
    "eslint": "^10.0.3",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "dependencies": {
    "express": "^4.21.2",
    "sqlite3": "^5.1.7"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
